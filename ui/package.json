{
  "name": "u1control-ui",
  "version": "0.21.0",
  "private": true,
  "type": "module",
  "description": "U1 Control pages (Vue 3 + PrimeVue 5, shared Orca UI foundation 5.6.2), built into one offline HTML file",
  "scripts": {
    "typecheck": "node node_modules/@orca-plugins/ui-foundation/scripts/vue-tsc.mjs --noEmit",
    "build": "node node_modules/@orca-plugins/ui-foundation/scripts/vue-tsc.mjs --noEmit && vite build && node scripts/emit.mjs",
    "test:unit": "node --import ./tests/unit/foundation-ts.mjs --test tests/unit/*.test.ts",
    "test:page": "node tests/page/run.mjs",
    "test": "npm run test:unit && npm run test:page"
  },
  "dependencies": {
    "@orca-plugins/ui-foundation": "github:bloodf/orca-ui-foundation#v5.10.0",
    "@primeuix/themes": "3.1.1",
    "primevue": "5.0.5",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-vue": "6.0.11",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4",
    "vue-tsc": "3.3.14"
  }
}
